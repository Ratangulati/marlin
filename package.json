{
  "name": "marlin",
  "version": "1.0.0",
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
    "build:watch": "ncc build src/index.ts -o dist --watch",
    "clean": "rm -rf dist",
    "all": "npm run clean && npm run build",
    "test": "vitest run"
  },
  "author": "Ratan Gulati",
  "license": "MIT",
  "description": "GitHub Action that reviews pull requests with Google Gemini and posts severity-grouped comments",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ratangulati/marlin.git"
  }
}
